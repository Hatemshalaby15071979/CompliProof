# CompliProof — gitignore

# Build artifacts
dist/
build/
*.egg-info/
*.whl
/helix-prime/
/helix-education/

# Evidence run artefacts: the installed-wheel tree duplicates src/ and the
# wheels are rebuilt on demand. Logs, JSON and checksum manifests stay tracked
# as the single canonical evidence copy. Attach artefacts to a release if one
# is ever published; do not commit them.
evidence/**/package/install/
evidence/**/package/wheels/

# Python
__pycache__/
*.py[cod]
*.so
.Python
.env/
.venv/
venv/
env/

# Test/cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime data, uploads, credentials, and audit ledgers
/workspace/
.env*
!.env.example
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx

# Local runtime data (workspace contains simulated/demo data and audit ledgers)
workspace/*.jsonl
workspace/sessions.json
workspace/*.csv
/evidence/p0-remediation-2026-10-31/synthetic-workspace-backup.tar.gz

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
